@page "/"

<PageTitle>Home - Visual Studio Wallpapers</PageTitle>

<HeadContent>
    <meta property="og:image" content="wallpapers/desktop/thumbnails/022.jpg" />
    <meta property="og:image:alt" content="Preview of Visual Studio wallpapers collection for desktop" />
</HeadContent>

<section aria-label="Home page content">
    <div class="hero">
        <h2 id="device-selection-heading">Choose Your Device</h2>
        <p class="hero-subtitle">Beautiful wallpapers crafted for every screen</p>
        <div class="grid device-grid" role="list" aria-labelledby="device-selection-heading">

            <a class="card device-card" href="desktop" role="listitem" aria-label="Browse desktop wallpapers">
                <div class="image-container">
                    <img src="wallpapers/desktop/thumbnails/022.jpg" alt="Preview of desktop wallpapers collection">
                    <div class="card-overlay">
                        <span class="view-btn">View Collection →</span>
                    </div>
                </div>
                <div class="card-content">
                    <h3>Desktop Wallpapers</h3>
                    <p class="device-icon">🖥️</p>
                    <span class="hint" aria-hidden="true">4K, Ultrawide &amp; more</span>
                </div>
            </a>

            <a class="card device-card" href="phone" role="listitem" aria-label="Browse phone wallpapers">
                <div class="image-container">
                    <img src="wallpapers/phone/320x568/023.jpg" alt="Preview of phone wallpapers collection">
                    <div class="card-overlay">
                        <span class="view-btn">View Collection →</span>
                    </div>
                </div>
                <div class="card-content">
                    <h3>Phone Wallpapers</h3>
                    <p class="device-icon">📱</p>
                    <span class="hint" aria-hidden="true">iPhone &amp; Android sizes</span>
                </div>
            </a>

            <a class="card device-card" href="watch" role="listitem" aria-label="Browse watch wallpapers">
                <div class="image-container">
                    <img src="wallpapers/watch/368x448/024.jpg" alt="Preview of watch wallpapers collection">
                    <div class="card-overlay">
                        <span class="view-btn">View Collection →</span>
                    </div>
                </div>
                <div class="card-content">
                    <h3>Watch Wallpapers</h3>
                    <p class="device-icon">⌚</p>
                    <span class="hint" aria-hidden="true">Apple Watch &amp; more</span>
                </div>
            </a>

        </div>
    </div>

    <div class="archive-link">
        <a href="archive" aria-label="View community archive wallpapers">✨ Explore the Community Archives</a>
    </div>
</section>
