{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Blazor WASM",
            "type": "process",
            "command": "dotnet",
            "args": ["watch", "run"],
            "isBackground": true,
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build",
            "type": "process",
            "command": "dotnet",
            "args": ["build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        }
    ]
}